# Copy to .env (chmod 600) and fill in. Never commit .env or paste it anywhere.

# Discord Developer Portal > your application
# General Information > Application ID
DISCORD_CLIENT_ID=
# OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# Bot > Reset Token
DISCORD_TOKEN=

# develop.battle.net > API Access > Create Client
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Long random string for signing sign-in cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PUBLIC_URL=https://wow.chille.sh
HOST=127.0.0.1
PORT=3000
REFRESH_MINUTES=15
