# /etc/systemd/system/guild-tracker.service
# Edit User and WorkingDirectory to match chille, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now guild-tracker
#   journalctl -u guild-tracker -f     (logs)

[Unit]
Description=WoW guild tracker (Discord bot + settings site)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=josh
WorkingDirectory=/home/josh/guild-tracker
ExecStart=/usr/bin/env node --env-file=.env src/index.js
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/josh/guild-tracker/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
